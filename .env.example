# Supabase Configuration for Jagori Tree Tracker
# Replace with your actual project credentials from Supabase Dashboard > Project Settings > API

EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-actual-anon-key-here

# Optional: Set this to your live public domain (e.g. https://jagori-trees.vercel.app)
# When set, any QR code generated will automatically encode this live URL so anyone can scan it in the field
EXPO_PUBLIC_QR_BASE_URL=https://your-app.vercel.app

# NGO Staff Admin Passcode (Default: 2026)
EXPO_PUBLIC_ADMIN_PIN=2026

