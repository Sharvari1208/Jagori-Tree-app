{
  "expo": {
    "name": "Jagori Tree Tracker",
    "slug": "jagori-tree-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "org.jagori.treetracker",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Jagori Tree Tracker",
      "shortName": "Jagori Trees",
      "description": "Official Tree Conservation & Verification Registry by Jagori Charitable Trust",
      "themeColor": "#15803d",
      "backgroundColor": "#f9fafb",
      "display": "standalone"
    },
    "plugins": [
      "expo-sharing",
      "expo-status-bar"
    ]
  }
}
